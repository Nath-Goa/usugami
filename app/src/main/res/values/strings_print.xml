<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: Print. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A button and a menu item for a PDF, on the result screen and in Recent files: opens Android's
         own print screen (preview, printer, copies, paper size, "Save as PDF") with the PDF. -->
    <string name="print">Print</string>
    <!-- The screen reader's label for one PDF's own Print button, among several PDFs, like
         "Open %1$s" and "Share %1$s". %1$s is the PDF's file name, such as "Report.pdf". -->
    <string name="print_file">Print %1$s</string>
    <!-- Shown when the phone has printing but it can't be started (its print service is turned off,
         for example). -->
    <string name="msg_no_printing">Printing isn\'t available on this phone.</string>
    <!-- Shown by Android's print screen when the PDF being printed can't be read. -->
    <string name="print_failed">Couldn\'t send this PDF to print. It may have been moved or deleted, or the phone\'s storage may be full.</string>
</resources>
