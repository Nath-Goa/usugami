<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: Document info. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A tool's name on Home and at the top of its screen. -->
    <string name="tool_document_info">Document info</string>
    <!-- Under the tool's name on Home. In French, no word that begins with "supprimer": Home's search
         finds Reorganize PDF alone with it ("effacer" or "retirer" can say it here). -->
    <string name="tool_document_info_detail">See, change or remove the title, author and more</string>
    <!-- Hidden words that also find Document info when searched for on Home, separated by commas.
         They are never shown: use the words people would type in this language for what the tool
         does. No word that begins with batch, many, several, multiple or bulk: those find the tools
         that work on several files at once. In French, no word that begins with "supprimer": Home's
         search finds Reorganize PDF alone with it ("effacer" or "retirer" can say it here). -->
    <string name="search_keywords_document_info">metadata, properties, details, title, author, subject, keywords, tags, creator, producer, date, privacy, anonymous, clean, remove info, XMP</string>
    <!-- The button that saves the PDF with its title, author and the like as chosen. -->
    <string name="pdf_document_info_action">Save PDF</string>

    <!-- Shown under a progress bar for the moment it takes to read the PDF's title, author and the like. -->
    <string name="docinfo_reading">Reading this PDF\'s info…</string>
    <!-- Labels of the four fields that can be changed: the PDF's title, its author (a person's or
         an organisation's name), its subject (what it is about) and its keywords. -->
    <string name="docinfo_title">Title</string>
    <string name="docinfo_author">Author</string>
    <string name="docinfo_subject">Subject</string>
    <string name="docinfo_keywords">Keywords</string>
    <!-- Under the Keywords field. -->
    <string name="docinfo_keywords_hint">Separate keywords with commas.</string>
    <!-- Under a field whose value in the PDF is longer than the field shows: left alone, the whole
         value stays in the new PDF; changed, only what the field shows is kept. -->
    <string name="docinfo_cut">This is too long to show in full. If you change it, only what you see here is kept.</string>
    <!-- Heading over what else the PDF says of itself, which can't be changed here. -->
    <string name="docinfo_about">About this PDF</string>
    <!-- Labels of the rows under "About this PDF": when the PDF was made, when it was last changed. -->
    <string name="docinfo_created">Created</string>
    <string name="docinfo_changed">Changed</string>
    <!-- Label of the row naming the apps that made the PDF (such as "Microsoft Word · macOS Quartz PDFContext"). -->
    <string name="docinfo_made_with">Made with</string>
    <!-- The two apps that made the PDF: the one it was written in, then the one that made the PDF of it. -->
    <string name="docinfo_made_with_both" translatable="false">%1$s · %2$s</string>
    <!-- Label of the row giving the number of pages. -->
    <string name="docinfo_pages">Pages</string>
    <!-- Label of the row giving the PDF's version, such as 1.7. -->
    <string name="docinfo_version">PDF version</string>
    <!-- Label of the row giving how much storage the PDF takes, such as 2.4 MB. -->
    <string name="docinfo_size">File size</string>
    <!-- In a row under "About this PDF" when the PDF doesn't say it. -->
    <string name="docinfo_not_set">Not set</string>
    <!-- A button. Nothing is removed until the PDF is saved. -->
    <string name="docinfo_remove_all">Remove all info</string>
    <!-- Under the Remove all info button. -->
    <string name="docinfo_remove_all_hint">Removes the title, author, subject, keywords, dates and app names, and the hidden info other apps keep in a PDF. Pages, comments, form fields and signatures are kept.</string>
    <!-- In the Created, Changed and Made with rows once Remove all info is chosen, in place of their value. -->
    <string name="docinfo_will_be_removed">Will be removed</string>
    <!-- Replaces the Remove all info button once it is tapped, above an Undo button. -->
    <string name="docinfo_removing">All info will be removed when you save. You can still type a new title, author, subject or keywords.</string>
    <!-- Above the fields, for a PDF with a digital signature that still holds. -->
    <string name="docinfo_signed_note">This PDF is digitally signed. Saving makes a new PDF, and the signature won\'t be valid in it. Your original file isn\'t changed.</string>
    <!-- Said after saving, when part of the PDF's info (its XMP metadata) was damaged or in a form
         Usugami can't read, and so isn't in the new PDF. -->
    <string name="docinfo_xmp_dropped">Some extra info in this PDF couldn\'t be read, so the new PDF doesn\'t have it.</string>
</resources>
