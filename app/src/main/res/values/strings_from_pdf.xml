<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: PDF to images or text. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A heading on Home, over the tools that make other files of a PDF. -->
    <string name="home_section_from_pdf">Convert from PDF</string>
    <!-- A tool's name on Home and at the top of its screen. -->
    <string name="tool_pdf_to_images_or_text">PDF to images or text</string>
    <!-- JPG and PNG are names of image formats: keep them as they are. -->
    <string name="tool_pdf_to_images_or_text_detail">Save pages as JPG or PNG, or copy the text</string>
    <!-- Hidden words that also find PDF to images or text when searched for on Home, separated by
         commas. They are never shown: use the words people would type in this language for what the
         tool does. No word that begins with batch, many, several, multiple or bulk: those find the
         tools that work on several files at once. -->
    <string name="search_keywords_pdf_to_images_or_text">JPG, JPEG, PNG, picture, photo, image, export, extract, convert, text, txt, copy, words, screenshot</string>
    <!-- The button that makes the images or the text. -->
    <string name="pdf_to_images_or_text_action">Convert</string>
</resources>
