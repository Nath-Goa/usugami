<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: launcher shortcuts. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- The short labels of the four shortcuts a long-press on Usugami's icon shows; their long labels
         are the names of Home's tiles. -->
    <!-- The shortcut that opens the camera for a new scan, as Scan document does. Under a shortcut's
         icon on the phone's home screen: one word, at most about 10 letters. -->
    <string name="shortcut_scan">Scan</string>
    <!-- The shortcut that opens Images to PDF. Under a shortcut's icon on the phone's home screen: one
         word, at most about 10 letters. -->
    <string name="shortcut_images">Images</string>
    <!-- The shortcut that opens Merge PDF. Under a shortcut's icon on the phone's home screen: one
         word, at most about 10 letters. -->
    <string name="shortcut_merge">Merge</string>
    <!-- The shortcut that opens Compress PDF. Under a shortcut's icon on the phone's home screen: one
         word, at most about 10 letters. -->
    <string name="shortcut_compress">Compress</string>
    <!-- Said when a launcher shortcut is used while Usugami is still making something (a PDF, images, a
         text file): nothing opens and the work goes on. "Usugami" is the app's name, kept as it is. -->
    <string name="shortcut_busy">Usugami is still working. Use the shortcut again once it is done.</string>
    <!-- Under "Discard this PDF?", asked when a launcher shortcut is used while a tool shows a PDF it
         made that isn't saved yet. Discard opens the shortcut's tool; Keep stays with the PDF. -->
    <string name="shortcut_discard_body">This PDF isn\'t saved yet. Save it first if you want to keep it.</string>
    <!-- Under "Discard your changes?", asked when a launcher shortcut is used while a tool has changes to
         its PDF that aren't saved yet. Discard opens the shortcut's tool; Keep stays with the changes. -->
    <string name="shortcut_discard_changes">Opening another tool discards your changes to this PDF.</string>
    <!-- Under "Discard what you made?", asked when a launcher shortcut is used while a tool shows images or
         a text file it made (no PDF) that aren't saved yet. "What you just made" is those files. Discard
         opens the shortcut's tool; Keep stays with them. -->
    <string name="shortcut_discard_files">What you just made isn\'t saved yet. Save it first if you want to keep it.</string>
</resources>
