    <!-- About -->
    <string name="about">About Usugami</string>
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_edition_standard">Standard edition: text recognition through Google Play services</string>
    <string name="about_edition_offline">Offline edition: text recognition built in</string>
    <string name="about_privacy">No ads, no tracking, no account. Usugami has no internet permission, and your files never leave your phone.</string>
    <string name="about_privacy_standard">Text recognition comes from Google Play services, which downloads the model for each language the first time you use it. Google Play services may also send Google statistics about how text recognition is used, but never your images or the recognized text. Usugami Offline doesn\'t use Google Play services for text recognition.</string>
