<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: Reorganize PDF. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them as
     it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Reorganize PDF: a button beside the page count that selects every page in the grid. -->
    <string name="reorganize_select_all">Select all</string>
    <!-- The same button while every page is selected: it takes them all out of the selection. -->
    <string name="reorganize_select_none">Select none</string>
    <!-- The label of a field where the selected pages are typed as numbers and ranges, like 2,5-7. -->
    <string name="reorganize_pages_field">Selected pages</string>
    <!-- Read by a screen reader: the button at the end of that field, which empties it and the selection. -->
    <string name="reorganize_pages_clear">Clear the selected pages</string>
    <!-- In the bar above the pages while none is selected. -->
    <string name="reorganize_tap_pages">Tap pages to select them</string>
    <!-- In the same bar while two or more pages are selected: %1$d pages are selected, out of the %2$d pages in the list. -->
    <string name="reorganize_selected_count">Selected: %1$d of %2$d</string>
    <!-- Under the pages. Pages added with "Add pages" go after the selected page that comes last. -->
    <string name="reorganize_move_hint">Long-press a page and drag to move it. Pages you add go after the last selected page.</string>
    <!-- Read by a screen reader: buttons in the bar that turn every selected page a quarter turn. -->
    <string name="rotate_selected_left">Rotate the selected pages left</string>
    <string name="rotate_selected_right">Rotate the selected pages right</string>
    <!-- Read by a screen reader: the button in the bar that takes the selected pages out (never fewer than 2). -->
    <plurals name="remove_selected_pages">
        <item quantity="one">Remove %d page</item>
        <item quantity="other">Remove %d pages</item>
    </plurals>
</resources>
