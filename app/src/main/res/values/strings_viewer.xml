<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: Read and annotate. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A heading on Home, first of all, over the tool that opens a file to read it. -->
    <string name="home_section_view">View</string>
    <!-- A tool's name on Home and at the top of its screen: it opens a PDF, or a Word, Excel, PowerPoint or EPUB file, to read it and to add to it. -->
    <string name="tool_reader">Read and annotate</string>
    <!-- What the tool does, under its name on Home. -->
    <string name="tool_reader_detail">Open a PDF or document to search, copy text, draw and highlight</string>
    <!-- Hidden words that also find Read and annotate when searched for on Home, separated by commas.
         They are never shown: use the words people would type in this language for what the tool
         does. No word that begins with batch, many, several, multiple or bulk: those find the tools
         that work on several files at once. -->
    <string name="search_keywords_reader">open, view, viewer, reader, look at, edit, annotation, note, write, type, pen, markup, shape, arrow, picture, select, find, zoom</string>
    <!-- Shown in the middle of the screen while a file opened is copied in and read, with a moving bar and Cancel. -->
    <string name="reader_opening">Opening…</string>
    <!-- %1$s is the file's name, as it is (for example "notes.txt"). -->
    <string name="reader_cant_open">Usugami can\'t open %1$s. It opens PDF, Word, Excel, PowerPoint and EPUB files.</string>
    <string name="reader_unreadable">Usugami couldn\'t read that file. Please open it again.</string>
    <!-- Said when a file is opened while Usugami makes a PDF: the file opens once the PDF is made. -->
    <string name="reader_open_waits">Your file will open once this is done.</string>
    <!-- Under "Discard your changes?", when a file was opened while a tool's PDF had changes not saved. -->
    <string name="reader_open_discard_changes">The file you opened is ready. Opening it discards your changes to this PDF.</string>
    <!-- Under "Discard this PDF?", when a file was opened while a PDF made by a tool wasn't saved yet. -->
    <string name="reader_open_discard_body">The file you opened is ready, but this PDF isn\'t saved yet. Save it first if you want to keep it.</string>
    <!-- Under "Discard what you made?", when a file was opened while images or a text file made from a PDF weren't saved yet. -->
    <string name="reader_open_discard_files">The file you opened is ready, but what you just made isn\'t saved yet. Save it first if you want to keep it.</string>
    <string name="reader_open_interrupted">Usugami was closed before it had opened your file. Please open it again.</string>
    <!-- On a small label at the bottom of the reader: the page showing (%1$d) of how many pages (%2$d), as in "3 of 12". -->
    <string name="reader_page_of">%1$d of %2$d</string>
    <!-- What a screen reader says of a page, and of that label: "Page 3 of 12". -->
    <string name="reader_page_of_spoken">Page %1$d of %2$d</string>
    <!-- On a page Android couldn't draw, in place of the page. -->
    <string name="reader_page_failed">This page can\'t be shown.</string>
</resources>
