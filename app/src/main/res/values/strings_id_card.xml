<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: ID card scan. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- The name of a page in Images to PDF that holds both sides of an identity document (an ID card, driving licence, bank card or passport page), one above the other. Stands for any identity document, not only a national ID card. -->
    <string name="card_title">ID card</string>
    <!-- One of the two sides of an ID card: the side with the photo and name. -->
    <string name="card_front">Front side</string>
    <!-- The other side of an ID card. -->
    <string name="card_back">Back side</string>
    <!-- A menu item on an ID card's page: opens the crop screen for the card's front side. -->
    <string name="card_crop_front">Crop front side</string>
    <!-- A menu item on an ID card's page: opens the crop screen for the card's back side. -->
    <string name="card_crop_back">Crop back side</string>
    <!-- A quieter button on Home's Scan document card, under Take photo and Upload images: scans the front and the back of an identity document (an ID card, driving licence, bank card or passport page) onto one page of the PDF. -->
    <string name="scan_id_card">ID card: both sides on one page</string>
    <!-- On the screen that asks for an ID card's front side, under the heading "Front side" (card_front). -->
    <string name="card_front_hint">Put the card on a plain, dark surface. Hold the phone straight above it, close enough for the card to fill most of the photo.</string>
    <!-- A smaller note under card_front_hint: the PDF has one page with both sides of the card on it, each at the card's real size when printed. -->
    <string name="card_note">Both sides go on one page, at the card\'s real size.</string>
    <!-- On the screen that asks for an ID card's back side, under the heading "Back side" (card_back). "No back side" is the name of a button on the same screen (card_no_back): use the same words as there. -->
    <string name="card_back_hint">Turn the card over and do the same. For a card with one side, choose No back side.</string>
    <!-- A button on the screens that ask for an ID card's sides: picks one image of the side from the phone, in place of taking a photo. -->
    <string name="card_choose_image">Choose image</string>
    <!-- A button on the screen that asks for an ID card's back side (also the description of its close button): the card is kept with its front side alone. Quoted in card_back_hint. -->
    <string name="card_no_back">No back side</string>
    <!-- Beside a progress ring on the screens that ask for an ID card's sides, while the photo just taken or the image chosen is being added. -->
    <string name="card_adding">Adding the image…</string>
    <!-- Above the photo on the crop screen of an ID card's side, when Usugami found the card on it. -->
    <string name="card_crop_found">Usugami found the card. Drag the corners or sides to adjust it.</string>
    <!-- Above the photo on the crop screen of an ID card's side, when Usugami didn't find the card on it. -->
    <string name="card_crop_not_found">Drag the corners or sides onto the edges of the card.</string>
    <!-- On the crop screen of an ID card's side, in place of the hint, while the four corners dragged don't make the outline of a card. -->
    <string name="card_crop_not_a_card">The corners don\'t make a card: put each one on a corner of the card.</string>
    <!-- A button on an ID card's page in Images to PDF, when the card has its front side only: asks for its back side. -->
    <string name="card_add_back">Add back side</string>
</resources>
