<?xml version="1.0" encoding="utf-8"?>
<!-- Usugami 2.0.0: Read and annotate. English only for now. The translations lane translates these
     strings, moves them where they belong and takes tools:ignore away, so that lint checks them
     as it checks the rest. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- A heading on Home, first of all, over the tool that opens a file to read it. -->
    <string name="home_section_view">View</string>
    <!-- A tool's name on Home and at the top of its screen: it opens a PDF, or a Word, Excel, PowerPoint or EPUB file, to read it and to add to it. -->
    <string name="tool_reader">Read and annotate</string>
    <!-- What the tool does, under its name on Home. -->
    <string name="tool_reader_detail">Open a PDF or document to search, copy text, draw and highlight</string>
    <!-- Hidden words that also find Read and annotate when searched for on Home, separated by commas.
         They are never shown: use the words people would type in this language for what the tool
         does. No word that begins with batch, many, several, multiple or bulk: those find the tools
         that work on several files at once. -->
    <string name="search_keywords_reader">open, view, viewer, reader, look at, edit, annotation, note, write, type, pen, markup, shape, arrow, picture, select, find, zoom</string>
    <!-- Shown in the middle of the screen while a file opened is copied in and read, with a moving bar and Cancel. -->
    <string name="reader_opening">Opening…</string>
    <!-- %1$s is the file's name, as it is (for example "notes.txt"). -->
    <string name="reader_cant_open">Usugami can\'t open %1$s. It opens PDF, Word, Excel, PowerPoint and EPUB files.</string>
    <string name="reader_unreadable">Usugami couldn\'t read that file. Please open it again.</string>
    <!-- Said when a file is opened while Usugami makes a PDF: the file opens once the PDF is made. -->
    <string name="reader_open_waits">Your file will open once this is done.</string>
    <!-- Under "Discard your changes?", when a file was opened while a tool's PDF had changes not saved. -->
    <string name="reader_open_discard_changes">The file you opened is ready. Opening it discards your changes to this PDF.</string>
    <!-- Under "Discard this PDF?", when a file was opened while a PDF made by a tool wasn't saved yet. -->
    <string name="reader_open_discard_body">The file you opened is ready, but this PDF isn\'t saved yet. Save it first if you want to keep it.</string>
    <!-- Under "Discard what you made?", when a file was opened while images or a text file made from a PDF weren't saved yet. -->
    <string name="reader_open_discard_files">The file you opened is ready, but what you just made isn\'t saved yet. Save it first if you want to keep it.</string>
    <string name="reader_open_interrupted">Usugami was closed before it had opened your file. Please open it again.</string>
    <!-- On a small label at the bottom of the reader: the page showing (%1$d) of how many pages (%2$d), as in "3 of 12". -->
    <string name="reader_page_of">%1$d of %2$d</string>
    <!-- What a screen reader says of a page, and of that label: "Page 3 of 12". -->
    <string name="reader_page_of_spoken">Page %1$d of %2$d</string>
    <!-- On a page Android couldn't draw, in place of the page. -->
    <string name="reader_page_failed">This page can\'t be shown.</string>
    <!-- The title of a small window that asks for a page number and shows that page; also what tapping the page label at the bottom of the reader does, as a screen reader says it. -->
    <string name="reader_go_to_page">Go to page</string>
    <!-- The label of the page number field in "Go to page". %1$d is the PDF's number of pages (at least 1): "Page number, 1 to 12". -->
    <string name="reader_page_field">Page number, 1 to %1$d</string>
    <!-- The button in "Go to page" that shows the page typed. -->
    <string name="reader_go">Go</string>
    <!-- Actions a screen reader offers on a page of the reader: they make the pages larger or smaller, as pinching does. -->
    <string name="reader_zoom_in">Zoom in</string>
    <string name="reader_zoom_out">Zoom out</string>
    <!-- Find text in the reader: the hint in the search field that takes the reader's top bar. -->
    <string name="reader_find_hint">Find in this file</string>
    <!-- Buttons beside the search field: they move to the match before or after the one marked, and close the search. -->
    <string name="reader_find_previous">Previous match</string>
    <string name="reader_find_next">Next match</string>
    <string name="reader_find_close">Close search</string>
    <!-- Beside the search field: the match marked (%1$d) of how many were found (%2$d), as in "3 of 17". -->
    <string name="reader_find_count">%1$d of %2$d</string>
    <!-- What a screen reader says of that count: "Match 3 of 17". -->
    <string name="reader_find_count_spoken">Match %1$d of %2$d</string>
    <string name="reader_find_none">Nothing found. Text in scans and pictures can\'t be searched.</string>
    <!-- %1$d is the most matches the reader keeps (2000): there were more. -->
    <string name="reader_find_capped" tools:ignore="PluralsCandidate">Showing the first %1$d matches. Try a longer phrase.</string>
    <!-- After a search, when some pages' text couldn't be read (a font that doesn't say which letters its shapes stand for). Counts the pages, so never 0. -->
    <plurals name="reader_find_unread">
        <item quantity="one">The text on %d page couldn\'t be read, so it wasn\'t searched.</item>
        <item quantity="other">The text on %d pages couldn\'t be read, so they weren\'t searched.</item>
    </plurals>
    <!-- The reader's menu of more actions (three dots at the top), as a screen reader names its button. -->
    <string name="reader_more">More</string>
    <!-- The title of a window that shows while a Word, Excel, PowerPoint or EPUB file opened in the reader is made into a PDF, with how far it has got and Cancel. -->
    <string name="reader_converting">Making a PDF of this file to show it…</string>
    <!-- In the reader's menu: leaves the reader for the list of tools, with this PDF in it. -->
    <string name="reader_tools">Tools</string>
    <!-- In the reader's menu: Android's list of the other apps that open this file. -->
    <string name="reader_open_elsewhere">Open with another app</string>
    <!-- A note under the reader's top bar for a Word, Excel, PowerPoint or EPUB file, which the reader shows as a PDF Usugami made of it. %1$s is the file's name, as it is (for example "Report.docx"). -->
    <string name="reader_converted_note">This is %1$s as Usugami lays it out as a PDF. It may look different in the app that made it.</string>
    <!-- A button in that note, and in the reader's menu: makes the PDF shown a file of its own, to share or save. -->
    <string name="reader_save_as_pdf">Save as PDF</string>
</resources>
