<?xml version="1.0" encoding="utf-8"?>
<!--
    Thin pages: three thin sheets fanned out from their bottom-left corner ("usugami" is Japanese
    for thin paper). Each sheet is a 30 x 40 rectangle with a same-colour stroke that rounds its
    corners; the back sheets are see-through, so their edges show where they overlap. Kept inside
    the 66 dp safe zone of the 108 dp adaptive-icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="41"
        android:translateY="33">
        <group
            android:pivotX="0"
            android:pivotY="40"
            android:rotation="-14">
            <path
                android:fillAlpha="0.5"
                android:fillColor="#4A3F6B"
                android:pathData="M0,0 L30,0 L30,40 L0,40 Z"
                android:strokeAlpha="0.5"
                android:strokeColor="#4A3F6B"
                android:strokeLineJoin="round"
                android:strokeWidth="4" />
        </group>
        <group
            android:pivotX="0"
            android:pivotY="40"
            android:rotation="-7">
            <path
                android:fillAlpha="0.69"
                android:fillColor="#4A3F6B"
                android:pathData="M0,0 L30,0 L30,40 L0,40 Z"
                android:strokeAlpha="0.69"
                android:strokeColor="#4A3F6B"
                android:strokeLineJoin="round"
                android:strokeWidth="4" />
        </group>
        <path
            android:fillColor="#4A3F6B"
            android:pathData="M0,0 L30,0 L30,40 L0,40 Z"
            android:strokeColor="#4A3F6B"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
    </group>
</vector>
